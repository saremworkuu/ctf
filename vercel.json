{
  "version": 2,
  "public": true,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/image/(.*)", "destination": "/public/image/$1" },
    { "source": "/(.*)", "destination": "/frontend/dist/$1" },
    { "source": "/(.*)", "destination": "/frontend/dist/index.html" }
  ]
}
